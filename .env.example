# ============================================================
# GENTELLE — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Secrets must never reach the client.
# ============================================================

# ---- Site ----
# Public base URL used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://gentelle.in

# ---- Supabase (server-side persistence) ----
# Create a project at https://supabase.com → Project Settings → API.
# The URL is safe to expose. The service role key is SECRET and server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (payments) ----
# Dashboard: https://dashboard.razorpay.com → Settings → API Keys.
# KEY_ID is exposed to the browser checkout widget (this is expected).
# KEY_SECRET and WEBHOOK_SECRET are SECRET and server-only.
# Leave blank to run the site in "payments disabled / Coming Soon" mode.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp / Instagram (public links) ----
NEXT_PUBLIC_WHATSAPP_NUMBER=917509400769
NEXT_PUBLIC_INSTAGRAM_HANDLE=gentelle_skincare

# ---- Contact inbox ----
CONTACT_NOTIFY_EMAIL=gentelleskincare@gmail.com
